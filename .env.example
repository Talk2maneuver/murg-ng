# ============================================================
# MURG Textile Enterprises — Environment Variable Reference
# ============================================================
# Copy this file and rename to backend/.env, then fill in values.
# NEVER commit backend/.env or any file with real credentials.
# ============================================================

# --- Node.js Environment ---
NODE_ENV=development          # 'development' | 'production'

# --- API Server ---
PORT=5000                     # Express API listens on this port

# --- Database (MySQL/MariaDB) ---
# Local XAMPP development defaults:
DB_HOST=localhost
DB_PORT=3306
DB_NAME=murg
DB_USER=root
DB_PASS=

# --- Authentication ---
# CHANGE THIS in production — use a long, random secret (32+ chars)
JWT_SECRET=change_this_to_a_random_secret_in_production
JWT_EXPIRES_IN=7d

# --- CORS ---
# React Vite dev server URL (development only)
CORS_ORIGIN=http://localhost:5173

# ============================================================
# XAMPP / PHP — No env vars needed for PHP.
# PHP reads from assets/mashaAllah/gyada.php (local defaults)
# or db_config.php at root (production override).
# See: db_config.php.example
# ============================================================
